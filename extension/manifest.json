{
  "manifest_version": 2,
  "name": "FocusBadge",
  "version": "1.0",
  "description": "FocusBadge is a minimalist browser extension that helps you stay focused and accountable during work/study hours — with integrity",
  "applications": {
    "gecko": {
      "id": "focusbadge@focusbadge.com"
    }
  },
  "permissions": [
    "identity",
    "storage",
    "https://accounts.google.com/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_start",
      "js": ["script.js"]
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "browser_action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "focusbadge": {
    "apiBaseUrl": "http://localhost:3000",
    "googleClientId": "458044860120-prq5t0h11e543c90lq9hqd4l3748n25u.apps.googleusercontent.com"
  }
}
