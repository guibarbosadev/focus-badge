{
  "manifest_version": 2,
  "name": "FocusBadge",
  "version": "1.0.0",
  "description": "Block distracting sites and prove it: a public badge shows whether your focus session stayed clean.",
  "homepage_url": "https://focusbadge.com",
  "browser_specific_settings": {
    "gecko": {
      "id": "focusbadge@focusbadge.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "personallyIdentifyingInfo",
          "browsingActivity"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "alarms",
    "identity",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "src/config.js",
      "src/lib.js",
      "src/background.js"
    ]
  },
  "web_accessible_resources": [
    "src/blocked/blocked.html"
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "browser_action": {
    "default_title": "FocusBadge",
    "default_popup": "src/popup/popup.html",
    "default_icon": "icons/icon.svg"
  }
}
